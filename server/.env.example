PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/cirql

CLIENT_URL=http://localhost:5173

JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret

# Optional: Redis
REDIS_URL=

# Required for file uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# Optional: WebRTC TURN server
# Comma-separated TURN URLs supplied by your TURN provider.
TURN_URL=

# TURN REST API shared secret. Keep this server-side only.
TURN_SECRET=

# Metered TURN credentials (backend only)
METERED_APP_URL=https://abhisek.metered.live
METERED_API_KEY=

